# Copy to /etc/nginx/sites-available/brgshopping (Debian/Ubuntu) or
# /etc/nginx/conf.d/brgshopping.conf (CentOS/RHEL), replace example.com with
# your real domain, then run `certbot --nginx -d example.com` — certbot
# rewrites this file in place to add the certificate paths and an
# HTTP->HTTPS redirect. See docs/DEPLOYMENT.md for the full walkthrough.

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    client_max_body_size 5m;
}
