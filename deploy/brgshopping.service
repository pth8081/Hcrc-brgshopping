# Copy to /etc/systemd/system/brgshopping.service, then edit the User=,
# WorkingDirectory= and EnvironmentFile= paths to match your deployment
# before running `systemctl daemon-reload && systemctl enable --now brgshopping`.
# See docs/DEPLOYMENT.md for the full walkthrough.

[Unit]
Description=BRG Shopping (Node.js + Express + MSSQL)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/brgshopping
EnvironmentFile=/home/deploy/brgshopping/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

# Hardening: the process can't write anywhere except its own directory tree,
# and has no reason to gain new privileges or see other users' processes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/deploy/brgshopping
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
