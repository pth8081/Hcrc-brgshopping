# --- App ---
PORT=3000
NODE_ENV=development
# Generate a real one for any non-local environment, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Optional: native HTTPS (only for a "PM2 only, no nginx" deployment) ---
# Set both to run this app as its own HTTPS server (PORT then defaults to
# the HTTPS port, e.g. 443) plus a plain-HTTP redirect listener on
# HTTP_REDIRECT_PORT. Leave both unset (the default) when nginx terminates
# TLS instead — see docs/DEPLOYMENT.md for both setups.
# TLS_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem
# TLS_CERT_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
# HTTP_REDIRECT_PORT=80

# --- Initial admin account (seeded by `npm run db:seed`) ---
# Leave ADMIN_PASSWORD unset to have the seeder generate and print a random
# one instead (shown once in the console output) — do this for any real
# deployment. Only set a fixed password here for local/demo convenience.
ADMIN_EMAIL=admin@brgshopping.local
# ADMIN_PASSWORD=ChangeMe123!

# --- Target database: MSSQL (this app runs on this) ---
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=brgshopping
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Passw0rd
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# --- Source database: the live Odoo installation (PostgreSQL) ---
# Only used by the one-off `npm run migrate:odoo` script — read-only access is enough.
ODOO_PG_HOST=localhost
ODOO_PG_PORT=5432
ODOO_PG_DATABASE=odoo_brg
ODOO_PG_USER=odoo
ODOO_PG_PASSWORD=
